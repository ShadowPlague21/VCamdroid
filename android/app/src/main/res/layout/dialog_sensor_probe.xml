<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oled_black"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header with Back / Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <ImageButton
            android:id="@+id/btnProbeBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sensor Probe - Real HAL Values"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDeviceInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Realme RMX2170 • 2 cameras"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Camera Tabs: Rear Camera / Front Camera / All -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_param_pill"
        android:orientation="horizontal"
        android:padding="3dp"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnTabRear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/accent_green"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Rear"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTabFront"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_control"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Front"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnTabAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_control"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="All IDs"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Capability Summary Card - REAL VALUES -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/surface_elevated"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/txtCameraIdHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Camera 0 - BACK - FULL"
                android:textColor="@color/accent_green"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_subtle"
                android:layout_marginVertical="8dp"/>

            <TextView
                android:id="@+id/txtHardwareLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HW Level: FULL | Logical: false | Physical: []"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/txtSensorInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sensor: Active 4608x3456 | Orient 90° | Pixel 9248x6944"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginTop="6dp"/>

            <TextView
                android:id="@+id/txtLensInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lens: f=5.58mm | MinFocus 0.1m | Fixed? No"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/txtControlsInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Controls: ISO 100-6400 | EV -4..4 step 1/3 | Zoom 1.0-8.0x"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/txtExposureInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exposure: 10ms-1s | FPS Ranges: [30,30] [15,30] [24,24]"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/txtFeaturesInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Features: Flash YES | AF: 0,1,2,3,4 | AWB: 1,2,3,4 | OIS: 1"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Resolutions Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Stream Resolutions (real HAL)"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtResolutionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12 modes"
            android:textColor="@color/accent_green"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:background="@drawable/bg_param_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"/>
    </LinearLayout>

    <!-- Scrollable Resolutions Container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/resolutionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnCopyClipboard"
            style="@style/Widget.VCamdroid.ParamPill"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/surface_elevated"
            android:text="Copy Resolutions"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCopyFullReport"
            style="@style/Widget.VCamdroid.ParamPill"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/accent_green"
            android:text="Copy Full HAL Report"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
